{
    "require": {
        "php": ">=8.2",
        "psr/log": "^3.0",
        "guzzlehttp/guzzle": "^7.9"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95"
    },
    "config": {
        "platform": {
            "php": "8.2"
        }
    },
    "scripts": {
