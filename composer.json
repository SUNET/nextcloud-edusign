{
    "name": "sunet/nextcloud-edusign",
    "description": "Edusign integration for Nextcloud",
    "license": "AGPL-3.0-or-later",
    "autoload": {
        "psr-4": {
            "OCA\\Edusign\\": "lib/"
        }
    },
    "require": {
        "php": ">=8.1",
        "psr/log": "^3.0",
        "guzzlehttp/guzzle": "^7.15.5"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95"
    },
    "config": {
        "vendor-dir": "composer",
        "platform": {
            "php": "8.1"
        }
    },
    "scripts": {
        "cs:fix": "php-cs-fixer fix",
        "cs:check": "php-cs-fixer fix --dry-run --diff"
    }
}
