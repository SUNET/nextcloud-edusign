{
  "name": "edusign",
  "version": "0.0.12",
  "scripts": {
    "build": "webpack --node-env production",
    "dev": "webpack --node-env development --progress",
    "watch": "webpack --node-env development --progress --watch",
    "serve": "webpack --node-env development serve --progress",
    "lint": "eslint --ext .js,.vue src scripts",
    "lint:fix": "eslint --ext .js,.vue src scripts --fix",
    "stylelint": "stylelint 'src/**/*.{vue,scss,css}'",
    "stylelint:fix": "stylelint 'src/**/*.{vue,scss,css}' --fix",
    "test": "vitest run"
  },
  "browserslist": [
    "extends @nextcloud/browserslist-config"
  ],
  "engines": {
    "node": "^24.15.0",
    "npm": "^12.2.0"
  },
  "allowScripts": {
    "@nextcloud/webpack-vue-config@7.0.4": true,
    "@parcel/watcher": false,
    "core-js": false
  },
  "dependencies": {
    "@nextcloud/axios": "^2.6.0",
    "@nextcloud/dialogs": "^7.5.0",
    "@nextcloud/files": "^4.1.0",
    "@nextcloud/l10n": "^3.4.1",
    "@nextcloud/router": "^3.2.0",
    "@nextcloud/vue": "^9.13.1",
    "vue": "^3.5.43",
    "vue-material-design-icons": "^5.3.1"
  },
  "devDependencies": {
    "@nextcloud/babel-config": "^1.3.0",
    "@nextcloud/browserslist-config": "^3.1.2",
    "@nextcloud/eslint-config": "^9.0.1",
    "@nextcloud/stylelint-config": "^3.2.2",
    "@nextcloud/webpack-vue-config": "^7.0.4",
    "eslint": "^10.12.0",
    "stylelint": "^17.16.0",
    "stylelint-config-html": "^1.1.0",
    "vitest": "^5.0.3"
  }
}
